rules_version = '2';

// Setup phase: browsers get no direct Firestore access.
// The Cloud Run API uses its service account (IAM), which these rules don't apply to.
// Read access for incidents/rules will be added with those features (see docs/ARCHITECTURE.md §15).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
