rules_version = '2';

// Browsers (anonymous Firebase Auth) may READ what the console displays live.
// All writes go through the Cloud Run API, which uses its service account (IAM) and bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /incidents/{id} {
      allow read: if signedIn();
    }
    match /rules/{id} {
      allow read: if signedIn();
    }
    match /cameras/{id} {
      allow read: if signedIn();
    }
    match /zones/{id} {
      allow read: if signedIn();
    }
    // The auto-tuned Tier-1 gate per camera; Live edge and Monitor listen to it.
    match /edge_config/{id} {
      allow read: if signedIn();
    }

    // Everything else (transactions, cache, counters, meta, selftest, feedback, scanner_photos) is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
